cat <<EOT > ~/.config/gtk-4.0/gtk.css
/* Cores que você escolheu */
@define-color window_bg_color #000000;
@define-color view_bg_color #000000;
@define-color sidebar_bg_color #0e0e0e;

/* GARANTIR VISIBILIDADE DOS BOTÕES: Removemos o background-color sólido da barra */
headerbar {
    background: none !important;
    background-color: transparent !important;
}

/* Aplicamos o preto apenas no container abaixo da barra de título */
.view, .main-window, window > stack {
    background-color: #000000 !important;
}

/* Barra lateral mantendo a separação visual */
.navigation-sidebar {
    background-color: @sidebar_bg_color !important;
}

/* Forçar os botões a não serem escondidos pelo CSS */
windowcontrols button {
    opacity: 1 !important;
    min-width: 12px;
    min-height: 12px;
}
EOT

