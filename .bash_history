cat <<EOT > ~/.config/gtk-4.0/gtk.css
/* Variáveis para visual estilo macOS */
@define-color window_bg_color #000000;
@define-color window_fg_color #ffffff;
@define-color view_bg_color #000000;
@define-color sidebar_bg_color #121212; /* Cinza grafite para a lateral */
@define-color sidebar_fg_color #ffffff;

/* Estilização da Barra Lateral */
.navigation-sidebar {
    background-color: @sidebar_bg_color !important;
    border-right: 1px solid #1a1a1a;
}

/* Área de conteúdo (Arquivos) em Preto Absoluto */
.view, .main-window, window {
    background-color: #000000 !important;
}

/* Recuperar botões do Mac (Garante transparência para os assets do tema) */
headerbar, .titlebar {
    background-color: transparent !important;
    border: none !important;
    box-shadow: none !important;
}

/* Melhorar contraste de itens selecionados */
selection {
    background-color: #333333;
}
EOT

